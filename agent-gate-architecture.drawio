<mxCell id="integration-label" value="NATIVE PLUGINS   ·   HOW THE DECISION IS ENFORCED" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1100" height="28" as="geometry"/></mxCell>
<mxCell id="claude" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Prompt + PreToolUse + result + CwdChanged hooks&lt;br&gt;Bash / Monitor + file tools. PowerShell needs review&lt;br&gt;Review → native ask; no-prompt → legacy denial path&lt;br&gt;CwdChanged cross-check; reconstructed Edit / MultiEdit&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="535" height="145" as="geometry"/></mxCell>
<mxCell id="codex" value="&lt;b&gt;Codex&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Native plugin hooks. Trust through /hooks&lt;br&gt;Prompt + PreToolUse + PostToolUse&lt;br&gt;Recover full shell arguments by exact call_id&lt;br&gt;Bundled MCP: Approve / Deny / More information&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="900" width="535" height="145" as="geometry"/></mxCell>
<mxCell id="hermes" value="&lt;b&gt;Hermes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;pre_llm_call + pre_tool_call + post_tool_call&lt;br&gt;Local terminal / write_file / patch in strict mode&lt;br&gt;Review → native approval with exact-call rule key&lt;br&gt;File contents checked. Remote / opaque calls need review&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#78350F;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="900" width="570" height="145" as="geometry"/></mxCell>
<mxCell id="support-label" value="STATE, APPROVALS &amp; VERIFICATION" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="900" height="28" as="geometry"/></mxCell>
<mxCell id="state" value="&lt;b&gt;Session state and logs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Bounded prompt history + untrusted tool results&lt;br&gt;Locked context and download state&lt;br&gt;reviews.json + legacy approvals + private log&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="535" height="125" as="geometry"/></mxCell>
<mxCell id="approval" value="&lt;b&gt;Codex in-session exact-action grant&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Client form response only · no chat approval&lt;br&gt;Bind host + session + cwd + tool + all arguments&lt;br&gt;Single use · 15 minutes · recheck policy on retry&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#78350F;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="615" y="1130" width="535" height="125" as="geometry"/></mxCell>
<mxCell id="tests" value="&lt;b&gt;Verification layers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;test_gate.py: core behavior and merge rules&lt;br&gt;probe_corpus.py: command classification + noise&lt;br&gt;Adapter / plugin tests. Hermes worker-thread dispatch&lt;br&gt;e2e/: real CLI + scripted model&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1190" y="1130" width="570" height="125" as="geometry"/></mxCell>
<mxCell id="runtime" value="&lt;b&gt;Shared parser runtime · explicit setup only&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;bootstrap.py --setup: private virtual environment + pinned tree-sitter / Bash grammar&lt;br&gt;Runtime key = Python major/minor + requirements hash. Reuse across hosts with the same key.&lt;br&gt;Tool hooks never install packages. Missing runtime / parser → denial after the launcher starts.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1290" width="1720" height="100" as="geometry"/></mxCell>
<mxCell id="boundary" value="BOUNDARY   OS isolation is still required against an adaptive same-user agent. MCP / hosted-tool actions and opaque program contents remain outside this gate." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#475569;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1420" width="1720" height="44" as="geometry"/></mxCell>
<mxCell id="legend" value="COLOR KEY   Blue: harness / context     Teal: parsing / facts / state     Purple: policy     Green: proceed     Amber: human review     Rose: deny" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#64748B;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="1480" width="1720" height="28" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

