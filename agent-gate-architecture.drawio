<mxCell id="parse" value="&lt;b&gt;Bash parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;shparse.parse()&lt;br&gt;Core: tree-sitter or fallback lexer&lt;br&gt;Plugins: pinned parser required&lt;br&gt;Words · cwd · pipes · redirects&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="analysis"><mxGeometry x="30" y="195" width="240" height="110" as="geometry"/></mxCell>
<mxCell id="file" value="&lt;b&gt;File change&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;check_write() / check_patch()&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="analysis"><mxGeometry x="30" y="365" width="240" height="75" as="geometry"/></mxCell>
<mxCell id="embedded" value="&lt;b&gt;Content inspection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;patch.py: reconstruct new content&lt;br&gt;embedded.py: extract shell snippets&lt;br&gt;Analyze with the same shell rules&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="analysis"><mxGeometry x="30" y="485" width="240" height="115" as="geometry"/></mxCell>
<mxCell id="facts" value="&lt;b&gt;Risk facts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;analyze() → _one() → _finish()&lt;br&gt;&lt;br&gt;Resolve paths and existing symlinks&lt;br&gt;Unwrap commands and nested code&lt;br&gt;Track fetched / executed files&lt;br&gt;&lt;br&gt;Writes · destruction · secrets&lt;br&gt;Egress · persistence · code execution&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F0FDFA;strokeColor=#14B8A6;fontColor=#134E4A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="analysis"><mxGeometry x="330" y="230" width="290" height="230" as="geometry"/></mxCell>
<mxCell id="floor" value="&lt;b&gt;Deterministic floor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;floor_verdict()&lt;br&gt;First matching policy rule wins&lt;br&gt;Agent origin uses stricter decisions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="policy"><mxGeometry x="20" y="80" width="260" height="110" as="geometry"/></mxCell>
<mxCell id="priority" value="&lt;b&gt;Policy priorities&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Gate tamper → block&lt;br&gt;Unknown parse / config / persistence&lt;br&gt;Exfil / unsafe writes / code → review&lt;br&gt;Network → log; strict → review&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="policy"><mxGeometry x="20" y="245" width="260" height="140" as="geometry"/></mxCell>
<mxCell id="merge" value="&lt;b&gt;Optional Laya advice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;laya_client.py · default off&lt;br&gt;Prompts + results + current action&lt;br&gt;2-second deadline · no retries&lt;br&gt;Can only raise the policy decision&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#F5F3FF;strokeColor=#8B5CF6;fontColor=#4C1D95;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="policy"><mxGeometry x="20" y="435" width="260" height="125" as="geometry"/></mxCell>
<mxCell id="run" value="&lt;b&gt;RUN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Proceed through harness permissions&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#ECFDF5;strokeColor=#10B981;fontColor=#064E3B;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="outcomes"><mxGeometry x="25" y="80" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="log" value="&lt;b&gt;LOG&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Proceed and record the decision&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="outcomes"><mxGeometry x="25" y="210" width="280" height="80" as="geometry"/></mxCell>
<mxCell id="review" value="&lt;b&gt;REVIEW&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Claude ask / Hermes approve&lt;br&gt;Codex deny → bundled MCP form&lt;br&gt;Client approval → exact retry&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#FFF7ED;strokeColor=#F59E0B;fontColor=#78350F;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="outcomes"><mxGeometry x="25" y="340" width="280" height="110" as="geometry"/></mxCell>
