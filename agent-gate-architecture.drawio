<mxCell id="call" value="&lt;b&gt;Agent tool call&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Shell command&lt;br&gt;Write / Edit / apply_patch&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="80" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="guard" value="&lt;b&gt;Hook guard&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;bootstrap.py → pinned parser runtime&lt;br&gt;Read JSON · bounded adapter process&lt;br&gt;Caught runtime / gate error → deny&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="240" width="250" height="110" as="geometry"/></mxCell>
<mxCell id="context" value="&lt;b&gt;Execution and task context&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Project root · actual cwd · host mode&lt;br&gt;Prompt history + tool results&lt;br&gt;Bounded evidence, never permission&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=16;fillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;strokeWidth=1.5;spacing=12;align=left;verticalAlign=middle;" vertex="1" parent="inputs"><mxGeometry x="20" y="420" width="250" height="110" as="geometry"/></mxCell>
